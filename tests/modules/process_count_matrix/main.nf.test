nextflow_process {

    name "Test Process PROCESS_COUNT_MATRIX"
    script "modules/local/process_count_matrix/main.nf"
    process "PROCESS_COUNT_MATRIX"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = Channel.of(file("${projectDir}/tests/fixtures/count_ref_matrix.tsv"))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should fail when the methylated counts exceed the total counts") {

        when {
            process {
                """
                def matrix = file("\${workDir}/wrong_counts.tsv")
                matrix.text = "chr\\tstart\\tend\\tcolon_meth\\tcolon_depth\\tlung_meth\\tlung_depth\\n" +
                    "chr1\\t10497\\t10588\\t20\\t10\\t5\\t10\\n"
                input[0] = Channel.of(matrix)
                """
            }
        }

        then {
            assert process.failed
            assert process.stdout.any { line -> line.contains("larger than the total counts") } ||
                process.stderr.any { line -> line.contains("larger than the total counts") }
        }

    }

}
