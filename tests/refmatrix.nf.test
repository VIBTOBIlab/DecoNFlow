nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"
    tag "cpu"

    test("Test scenario: reference matrix (--ref_matrix) + meth_atlas + Houseman") {

        when {
            params {
                outdir = "${outputDir}"
                // A reference matrix replaces the reference samples and the DMR selection
                input = null
                regions = null
                meth_atlas = true
                houseman_ineq = true
            }
        }

        then {
            // Round numeric values to 4 decimals so floating-point noise
            // doesn't differ between arm64 and x86_64
            def combined = path("$outputDir/deconvolution_results/combined_results_refbased.csv")
                .readLines()
                .collect { line ->
                    line.split(',', -1).collect { field ->
                        field.isBigDecimal()
                            ? new BigDecimal(field).setScale(4, java.math.RoundingMode.HALF_UP).toPlainString()
                            : field
                    }.join(',')
                }

            assertAll(
                { assert workflow.success },
                { assert !workflow.trace.tasks().any { task -> task.name.contains('LIMMA') } },
                { assert snapshot(
                    // Number of tasks
                    workflow.trace.succeeded().size(),
                    combined
                ).match() }
            )
        }
    }

    test("Test scenario: reference matrix + CelFiE without its own reference matrix is skipped with a warning") {

        when {
            params {
                outdir = "${outputDir}"
                input = null
                regions = null
                meth_atlas = true
                celfie = true
            }
        }

        then {
            // nf-test runs Nextflow with -quiet, so warnings are only in the log file
            def log = path("${outputDir}/../meta/nextflow.log").text
            assertAll(
                { assert workflow.success },
                { assert log.contains("CelFiE needs read counts: provide its own reference matrix (--celfie_ref_matrix) or the reference samples (--input)") },
                { assert log.contains("CelFiE is skipped") },
                { assert !path("$outputDir/deconvolution_results/combined_results_refbased.csv").text.contains("CelFiE") }
            )
        }
    }

    test("Test scenario: reference matrix + only CelFiE without its own reference matrix fails") {

        when {
            params {
                outdir = "${outputDir}"
                input = null
                regions = null
                // The test profile enables meth_atlas, which would let the run continue
                meth_atlas = false
                celfie = true
            }
        }

        then {
            def log = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert log.contains("CelFiE needs read counts: provide its own reference matrix (--celfie_ref_matrix) or the reference samples (--input), since it cannot use the beta values of the reference matrix (--ref_matrix)") }
            )
        }
    }

    test("Test scenario: reference matrix + CelFiE and MetDecode reference matrices (--celfie_ref_matrix, --metdecode_ref_matrix)") {

        when {
            params {
                outdir = "${outputDir}"
                // Each tool has its own reference matrix: no reference samples nor DMR selection
                input = null
                regions = null
                meth_atlas = true
                celfie = true
                metdecode = true
                // Read counts of the atlas built by the limma route of the test profile
                celfie_ref_matrix = "https://github.com/VIBTOBIlab/deconflow_testdata/raw/main/resources/count_ref_matrix.tsv"
                metdecode_ref_matrix = "https://github.com/VIBTOBIlab/deconflow_testdata/raw/main/resources/count_ref_matrix.tsv"
            }
        }

        then {
            def combined = path("$outputDir/deconvolution_results/combined_results_refbased.csv")
                .readLines()
                .collect { line ->
                    line.split(',', -1).collect { field ->
                        field.isBigDecimal()
                            ? new BigDecimal(field).setScale(4, java.math.RoundingMode.HALF_UP).toPlainString()
                            : field
                    }.join(',')
                }
            // MetDecode is not deterministic: check that it ran, but keep its values out of the snapshot
            def metdecode = combined.findAll { line -> line.endsWith(',MetDecode') }

            assertAll(
                { assert workflow.success },
                { assert !workflow.trace.tasks().any { task -> task.name.contains('LIMMA') } },
                { assert workflow.trace.tasks().any { task -> task.name.contains('PROCESS_CELFIE_MATRIX') } },
                { assert workflow.trace.tasks().any { task -> task.name.contains('PROCESS_METDECODE_MATRIX') } },
                { assert metdecode.size() == 3 },
                { assert snapshot(
                    // Number of tasks
                    workflow.trace.succeeded().size(),
                    combined - metdecode
                ).match() }
            )
        }
    }

    test("Test scenario: reference matrix for meth_atlas + reference samples for CelFiE") {

        when {
            params {
                outdir = "${outputDir}"
                // input, regions and ref_matrix come from tests/nextflow.config
                meth_atlas = true
                celfie = true
            }
        }

        then {
            def combined = path("$outputDir/deconvolution_results/combined_results_refbased.csv")
                .readLines()
                .collect { line ->
                    line.split(',', -1).collect { field ->
                        field.isBigDecimal()
                            ? new BigDecimal(field).setScale(4, java.math.RoundingMode.HALF_UP).toPlainString()
                            : field
                    }.join(',')
                }

            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().any { task -> task.name.contains('PROCESS_REF_MATRIX') } },
                { assert workflow.trace.tasks().any { task -> task.name.contains('LIMMA') } },
                { assert workflow.trace.tasks().any { task -> task.name.contains('TEST_PREPROCESSING_COUNTS') } },
                { assert snapshot(
                    // Number of tasks
                    workflow.trace.succeeded().size(),
                    combined
                ).match() }
            )
        }
    }

    test("Test scenario: reference matrix + reference samples used by no tool fails") {

        when {
            params {
                outdir = "${outputDir}"
                // input and ref_matrix come from tests/nextflow.config
                meth_atlas = true
            }
        }

        then {
            def log = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert log.contains("The reference samples (--input) are not used by any selected tool: the reference-based tools other than CelFiE and MetDecode use the reference matrix (--ref_matrix)") }
            )
        }
    }

    test("Test scenario: CelFiE reference matrix + reference samples used by no tool fails") {

        when {
            params {
                outdir = "${outputDir}"
                ref_matrix = null
                meth_atlas = false
                celfie = true
                celfie_ref_matrix = "https://github.com/VIBTOBIlab/deconflow_testdata/raw/main/resources/count_ref_matrix.tsv"
            }
        }

        then {
            def log = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert log.contains("The reference samples (--input) are not used by any selected tool: CelFiE uses its own reference matrix (--celfie_ref_matrix)") }
            )
        }
    }
}
