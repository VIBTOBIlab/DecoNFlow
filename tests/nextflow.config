/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

params {
    // Test data base path
    pipelines_testdata_base_path = "https://github.com/VIBTOBIlab/deconflow_testdata/raw/main/"

    // Input data
    input            = params.pipelines_testdata_base_path + '/resources/ref_cov.csv'
    regions          = params.pipelines_testdata_base_path + '/resources/RRBS_regions20-200_hg19_chr1_1M.bed'
    bulk_samples     = params.pipelines_testdata_base_path + '/resources/bulk_samples_cov.csv'
    ref_matrix       = params.pipelines_testdata_base_path + "/modules/limma/reference_matrix_limma.tsv"
    min_cpgs         = 0
    min_counts       = 0
    bulk_min_cpgs    = 0
    bulk_min_counts  = 0
    adjp             = 1
    outdir           = 'results'
}

// Impose sensible resource limits for testing
process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}
